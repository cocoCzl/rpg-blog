---
import BaseLayout from '../layouts/BaseLayout.astro'
import config from '../../site.config'
import { t } from '../lib/i18n'
import { formatDate } from '../lib/locale'
import { getPostSlug, groupPostsByYear, type PostEntry } from '../lib/posts'

interface Props {
  posts: PostEntry[]
  currentPage: number
  totalPages: number
  previousUrl?: string
  nextUrl?: string
}

const { posts, currentPage, totalPages, previousUrl, nextUrl } = Astro.props
const locale = config.locale
const groups = groupPostsByYear(posts)
const canonicalPath = currentPage === 1 ? '/archive' : `/archive/${currentPage}`
---

<BaseLayout
  title={t('archive.title', locale)}
  description={t('archive.description', locale)}
  canonicalUrl={`${config.siteUrl.replace(/\/$/, '')}${canonicalPath}`}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow" data-i18n="home.signpost">{t('home.signpost', locale)}</p>
      <h1 class="hero-title" data-i18n="archive.title">{t('archive.title', locale)}</h1>
      <p class="hero-copy" data-i18n="archive.description">{t('archive.description', locale)}</p>
    </div>
  </section>

  <section class="container stack">
    {groups.length > 0 ? groups.map((group) => (
      <section class="guild-panel panel-pad">
        <h2 class="section-title">{group.year}</h2>
        <div class="stack">
          {group.posts.map((post) => (
            <a href={`/posts/${getPostSlug(post)}`} class="journal-card">
              <span class="post-meta">{formatDate(post.data.date, locale)} {post.data.category ? ` / ${post.data.category}` : ''}</span>
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-summary">{post.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )) : (
      <p class="guild-panel panel-pad post-summary" data-i18n="archive.empty">{t('archive.empty', locale)}</p>
    )}

    {totalPages > 1 && (
      <nav class="pagination" aria-label={t('archive.pagination', locale)}>
        {previousUrl ? <a class="pixel-button" href={previousUrl} rel="prev" data-i18n="archive.previous">{t('archive.previous', locale)}</a> : <span />}
        <span>{currentPage} / {totalPages}</span>
        {nextUrl ? <a class="pixel-button" href={nextUrl} rel="next" data-i18n="archive.next">{t('archive.next', locale)}</a> : <span />}
      </nav>
    )}
  </section>
</BaseLayout>
