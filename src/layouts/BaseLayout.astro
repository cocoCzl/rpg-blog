---
import '../styles/global.css'
import config from '../../site.config'
import { themePresets } from '../lib/theme'
import { isConfigured } from '../lib/github-oauth'
import { loadLocale } from '../lib/i18n'
import { isGithubAuthEnabled, isRpgEnabled } from '../lib/features'
import { buildLocaleSwitchHref, getLocaleFromLocals } from '../lib/locale'
import { getSiteText } from '../lib/site-text'
import BackgroundSwitcher from '../components/vue/BackgroundSwitcher.vue'
import GlassNavbar from '../components/vue/GlassNavbar.vue'
import GlassFooter from '../components/vue/GlassFooter.vue'
import GithubLoginButton from '../components/vue/GithubLoginButton.vue'
import SakuraEffect from '../components/vue/SakuraEffect.vue'
import AuroraEffect from '../components/vue/AuroraEffect.vue'
import ToastContainer from '../components/vue/ToastContainer.vue'

const currentLocale = getLocaleFromLocals(Astro.locals)
await loadLocale(currentLocale)
const siteText = getSiteText(config, currentLocale)

const preset = themePresets[config.theme.preset]
const c = preset.colors

const cssVars = `:root {
  --color-primary: ${c.primary};
  --color-secondary: ${c.secondary};
  --color-accent: ${c.accent};
  --color-bg: ${c.background};
  --color-surface: ${c.surface};
  --color-text: ${c.text};
  --color-text-secondary: ${c.textSecondary};
  --font-heading: ${preset.fontFamily.heading};
  --font-body: ${preset.fontFamily.body};
  --font-mono: ${preset.fontFamily.mono};
  --font-scale: ${preset.fontScale};
  --color-success: #10B981;
  --color-error: #EF4444;
  --color-warning: #F59E0B;
}`

export interface Props {
  title?: string
  description?: string
  canonicalUrl?: string
  ogImage?: string
  ogType?: string
  articleDate?: string
  jsonLd?: object
}

const pageTitle = Astro.props.title
  ? `${Astro.props.title} - ${siteText.title}`
  : siteText.title
const pageDesc = Astro.props.description || siteText.description
const canonicalUrl = Astro.props.canonicalUrl || config.siteUrl + (Astro.url.pathname !== '/' ? Astro.url.pathname : '')
const ogImage = Astro.props.ogImage || `${config.siteUrl}/og-image?slug=${encodeURIComponent(Astro.props.title || '')}`
const jsonLdStr = Astro.props.jsonLd ? JSON.stringify(Astro.props.jsonLd) : ''
const showGithubLogin = isGithubAuthEnabled() && isConfigured()
const showRpgNav = isRpgEnabled()
const showRpgEffects = isRpgEnabled()
const switchLocale = currentLocale === 'zh' ? 'en' : 'zh'
const localeSwitchHref = buildLocaleSwitchHref(
  switchLocale,
  `${Astro.url.pathname}${Astro.url.search}${Astro.url.hash}`
)
const localeSwitchLabel = currentLocale === 'zh' ? 'EN' : '中文'
---

<!doctype html>
<html lang={currentLocale} class={preset.mode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content={siteText.authorName} />
    <meta property="og:locale" content={currentLocale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:site_name" content={siteText.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content={Astro.props.ogType || 'website'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    {
      Astro.props.ogType === 'article' && Astro.props.articleDate ? (
        <meta property="article:published_time" content={Astro.props.articleDate} />
      ) : null
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    {
      Astro.url.pathname === '/admin' || Astro.url.pathname.startsWith('/admin/') ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : null
    }
    {jsonLdStr ? <script type="application/ld+json" set:html={jsonLdStr} /> : null}
    <style is:inline set:html={cssVars} />
  </head>
  <body style={`font-family: var(--font-body); background-color: var(--color-bg); color: var(--color-text);`}>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm" style="background: var(--color-primary); color: var(--color-bg)">
      Skip to content
    </a>
    <BackgroundSwitcher client:visible />
    {showRpgEffects ? <SakuraEffect client:visible /> : null}
    {showRpgEffects ? <AuroraEffect client:visible /> : null}
    <GlassNavbar
      client:load
      showRpgLink={showRpgNav}
      localeSwitchHref={localeSwitchHref}
      localeSwitchLabel={localeSwitchLabel}
      locale={currentLocale}
      title={siteText.title}
    >
      {
        showGithubLogin ? (
          <GithubLoginButton slot="actions" locale={currentLocale} client:load />
        ) : null
      }
    </GlassNavbar>
    <div class="pt-14">
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
    </div>
    <GlassFooter locale={currentLocale} author={siteText.authorName} client:visible />
    <ToastContainer client:load />
  </body>
</html>
