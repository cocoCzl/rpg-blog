---
import BaseLayout from '../layouts/BaseLayout.astro'
import config from '../../site.config'
import { t } from '../lib/i18n'

const locale = config.locale
---

<BaseLayout title={`404 - ${t('system.not_found', locale)}`}>
  <section class="hero">
    <div class="container panel" style="text-align: center;">
      <h1 class="hero-title">404</h1>
      <p class="hero-copy" style="margin: 0 auto 1.5rem;" data-i18n="system.not_found">{t('system.not_found', locale)}</p>
      <a href="/" class="badge">
        &larr; {t('blog.back_home', locale)}
      </a>
    </div>
  </section>
</BaseLayout>
