---
import BaseLayout from '../../layouts/BaseLayout.astro'
import UploadWidget from '../../components/vue/UploadWidget.vue'
import { t } from '../../lib/i18n'
import { getLocaleFromLocals } from '../../lib/locale'

const locale = getLocaleFromLocals(Astro.locals)
const title = t('admin.image_upload', locale)
const backToDashboard = locale === 'zh' ? '&larr; 管理台' : '&larr; Dashboard'
---

<BaseLayout title={t('admin.upload', locale)}>
  <main class="min-h-screen" style="background: linear-gradient(to bottom right, var(--color-bg), var(--color-surface))">
    <div class="max-w-2xl mx-auto px-4 py-16">
      <div class="flex items-center justify-between mb-8">
        <h1 class="text-2xl font-bold" style="font-family: var(--font-heading)">{title}</h1>
        <a href="/admin" class="text-sm hover:underline" style="color: var(--color-text-secondary)" set:html={backToDashboard}></a>
      </div>
      <UploadWidget locale={locale} client:load />
    </div>
  </main>
</BaseLayout>
