---
import BaseLayout from '../../layouts/BaseLayout.astro'
import UploadWidget from '../../components/vue/UploadWidget.vue'
---

<BaseLayout title="Upload">
  <main class="min-h-screen" style="background: linear-gradient(to bottom right, var(--color-bg), var(--color-surface))">
    <div class="max-w-2xl mx-auto px-4 py-16">
      <div class="flex items-center justify-between mb-8">
        <h1 class="text-2xl font-bold" style="font-family: var(--font-heading)">Image Upload</h1>
        <a href="/admin" class="text-sm hover:underline" style="color: var(--color-text-secondary)">&larr; Dashboard</a>
      </div>
      <UploadWidget client:load />
    </div>
  </main>
</BaseLayout>
