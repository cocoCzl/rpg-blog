---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { isCommentsEnabled } from '../../lib/features'
import { t } from '../../lib/i18n'
import { getLocaleFromLocals } from '../../lib/locale'

const locale = getLocaleFromLocals(Astro.locals)
const title = t('admin.dashboard', locale)
const welcome = t('admin.welcome', locale)
const commentsLabel = t('admin.comments', locale)
const logoutLabel = t('admin.logout', locale)
---

<BaseLayout title={title}>
  <main class="min-h-screen" style="background: linear-gradient(to bottom right, var(--color-bg), var(--color-surface))">
    <div class="max-w-3xl mx-auto px-4 py-16">
      <div class="glass-card p-8 space-y-6">
        <h1 class="text-2xl font-bold" style="font-family: var(--font-heading); color: var(--color-text)">
          {title}
        </h1>
        <p style="color: var(--color-text-secondary)">
          {welcome}
        </p>
        <div class="flex gap-4">
          {isCommentsEnabled() && (
            <a href="/admin/comments" class="px-4 py-2 rounded-lg text-sm font-medium"
               style="background: var(--color-primary); color: var(--color-bg)">
              {commentsLabel}
            </a>
          )}
          <button class="px-4 py-2 rounded-lg text-sm font-medium"
                  style="background: var(--color-surface); color: var(--color-text)"
                  id="logout-btn">
            {logoutLabel}
          </button>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
<script is:inline src="/admin-dashboard.js"></script>
