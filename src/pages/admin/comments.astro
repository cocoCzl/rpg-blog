---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AdminComments from '../../components/vue/AdminComments.vue'
import { isCommentsEnabled } from '../../lib/features'
import { t } from '../../lib/i18n'
import { getLocaleFromLocals } from '../../lib/locale'

if (!isCommentsEnabled()) {
  Astro.response.status = 404
}

const locale = getLocaleFromLocals(Astro.locals)
const title = t('admin.moderation', locale)
const backToDashboard = locale === 'zh' ? '&larr; 管理台' : '&larr; Dashboard'
---

<BaseLayout title={title}>
  {isCommentsEnabled() ? (
    <main class="min-h-screen" style="background: linear-gradient(to bottom right, var(--color-bg), var(--color-surface))">
      <div class="max-w-3xl mx-auto px-4 py-16">
        <div class="flex items-center justify-between mb-8">
          <h1 class="text-2xl font-bold" style="font-family: var(--font-heading)">{title}</h1>
          <a href="/admin" class="text-sm hover:underline" style="color: var(--color-text-secondary)" set:html={backToDashboard}></a>
        </div>
        <AdminComments locale={locale} client:load />
      </div>
    </main>
  ) : (
    <main class="min-h-screen" />
  )}
</BaseLayout>
