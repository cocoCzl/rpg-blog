---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import config from '../../../site.config'
import { t } from '../../lib/i18n'
import { formatDate } from '../../lib/locale'
import { getAllTags, getPostSlug, getPostsByTag } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return getAllTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }))
}

const locale = config.locale
const { tag } = Astro.props
const posts = getPostsByTag(await getCollection('posts'), tag)
---

<BaseLayout title={`#${tag}`} description={t('tags.posts_with_tag', locale)}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow" data-i18n="tags.posts_with_tag">{t('tags.posts_with_tag', locale)}</p>
      <h1 class="hero-title">#{tag}</h1>
    </div>
  </section>

  <section class="container stack">
    {posts.map((post) => (
      <article class="journal-card panel-pad">
        <a href={`/posts/${getPostSlug(post)}`} style="text-decoration: none;">
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
            {post.data.category && <span>{post.data.category}</span>}
          </div>
          <h2 class="post-title">{post.data.title}</h2>
          <p class="post-summary">{post.data.summary}</p>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
