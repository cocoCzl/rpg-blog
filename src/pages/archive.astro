---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import config from '../../site.config'
import { t } from '../lib/i18n'
import { formatDate } from '../lib/locale'
import { getPostSlug, groupPostsByYear } from '../lib/posts'

const locale = config.locale
const groups = groupPostsByYear(await getCollection('posts'))
---

<BaseLayout title={t('archive.title', locale)} description={t('archive.description', locale)}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow" data-i18n="home.signpost">{t('home.signpost', locale)}</p>
      <h1 class="hero-title" data-i18n="archive.title">{t('archive.title', locale)}</h1>
      <p class="hero-copy" data-i18n="archive.description">{t('archive.description', locale)}</p>
    </div>
  </section>

  <section class="container stack">
    {groups.map((group) => (
      <section class="guild-panel panel-pad">
        <h2 class="section-title">{group.year}</h2>
        <div class="stack">
          {group.posts.map((post) => (
            <a href={`/posts/${getPostSlug(post)}`} class="journal-card" style="text-decoration: none;">
              <span class="post-meta">{formatDate(post.data.date, locale)} {post.data.category ? ` / ${post.data.category}` : ''}</span>
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-summary">{post.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>
