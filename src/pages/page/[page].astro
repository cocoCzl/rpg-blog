---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import config from '../../../site.config'
import ArticleCardList from '../../components/vue/ArticleCardList.vue'
import { t } from '../../lib/i18n'
import { getLocaleFromLocals } from '../../lib/locale'
import { filterPostsByLocale, sortPosts } from '../../lib/posts'
import { getSiteText } from '../../lib/site-text'

const allPosts = await getCollection('posts')
const locale = getLocaleFromLocals(Astro.locals)
const siteText = getSiteText(config, locale)
const sortedPosts = sortPosts(filterPostsByLocale(allPosts, locale))

const { page } = Astro.params
const currentPage = Number(page)
const pageSize = config.postsPerPage
const start = (currentPage - 1) * pageSize
const pageArticles = sortedPosts.slice(start, start + pageSize)
const totalPages = Math.ceil(sortedPosts.length / pageSize)
if (!Number.isInteger(currentPage) || currentPage < 1 || currentPage > totalPages) {
  Astro.response.status = 404
}
---

<BaseLayout title={`${t('blog.page', locale)} ${currentPage}`}>
  <main class="min-h-screen" style="background: linear-gradient(to bottom right, var(--color-bg), var(--color-surface))">
    <div class="max-w-3xl mx-auto px-4 py-16">
      <h1 class="text-3xl font-bold mb-8 text-center" style="font-family: var(--font-heading)">
        {siteText.title}
      </h1>
      <ArticleCardList
        articles={pageArticles}
        currentPage={currentPage}
        totalPages={totalPages}
        basePath="/page/"
        locale={locale}
        client:load
      />
    </div>
  </main>
</BaseLayout>
