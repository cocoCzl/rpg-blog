---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import config from '../../../site.config'
import { t } from '../../lib/i18n'
import { formatDate } from '../../lib/locale'
import { findPostBySlug, getAdjacentPosts, getPostLastModified, getPostSlug, getPostUrl } from '../../lib/posts'
import { getSiteText } from '../../lib/site-text'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.filter((post) => post.data.draft !== true).map((post) => ({
    params: { slug: getPostSlug(post) },
  }))
}

const locale = config.locale
const siteText = getSiteText(config, locale)
const { slug } = Astro.params
const posts = await getCollection('posts')
const post = slug ? findPostBySlug(posts, slug) : undefined
if (!post) throw new Error(`Post not found: ${slug}`)
const adjacent = getAdjacentPosts(posts, post)
const { Content } = await render(post)
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  canonicalUrl={getPostUrl(post, config.siteUrl)}
  ogType="article"
  articleDate={getPostLastModified(post).toISOString()}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.summary,
    datePublished: post.data.date.toISOString(),
    dateModified: getPostLastModified(post).toISOString(),
    author: { '@type': 'Person', name: siteText.authorName },
    image: post.data.cover ? `${config.siteUrl.replace(/\/$/, '')}${post.data.cover}` : undefined,
    url: getPostUrl(post, config.siteUrl),
  }}
>
  <article class="container journal-shell">
    <header class="guild-panel panel-pad journal-cover">
      <div class="post-meta">
        <span data-i18n="home.journal">{t('home.journal', locale)}</span>
        <time datetime={post.data.date.toISOString()}>{t('blog.published', locale)} {formatDate(post.data.date, locale)}</time>
        {post.data.updated && <span>{t('blog.updated', locale)} {formatDate(post.data.updated, locale)}</span>}
        {post.data.category && <span>{t('blog.category', locale)}: {post.data.category}</span>}
      </div>
      <h1 class="hero-title" style="font-size: clamp(2.6rem, 6vw, 4.8rem);">{post.data.title}</h1>
      <p class="hero-copy">{post.data.summary}</p>
      {post.data.tags.length > 0 && (
        <div class="tag-list">
          {post.data.tags.map((tag) => <a class="badge" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}
        </div>
      )}
    </header>

    {post.data.cover ? (
      <img src={post.data.cover} alt="" class="optional-cover" loading="eager" />
    ) : (
      <div class="no-cover-mark" aria-hidden="true">{post.data.category || t('home.journal', locale)}</div>
    )}

    <div class="guild-panel journal-paper prose-content">
      <Content />
    </div>

    <nav class="guild-grid" style="margin-top: 1.25rem;">
      <div class="guild-panel panel-pad">
        {adjacent.previous ? (
          <a href={`/posts/${getPostSlug(adjacent.previous)}`} style="text-decoration: none;">
            <span class="eyebrow" data-i18n="blog.previous">{t('blog.previous', locale)}</span>
            <h2 class="post-title">{adjacent.previous.data.title}</h2>
          </a>
        ) : <span class="post-summary"> </span>}
      </div>
      <div class="guild-panel panel-pad">
        {adjacent.next ? (
          <a href={`/posts/${getPostSlug(adjacent.next)}`} style="text-decoration: none;">
            <span class="eyebrow" data-i18n="blog.next">{t('blog.next', locale)}</span>
            <h2 class="post-title">{adjacent.next.data.title}</h2>
          </a>
        ) : <span class="post-summary"> </span>}
      </div>
    </nav>

    <aside class="guild-panel panel-pad" style="margin-top: 1.25rem;">
      <p class="eyebrow" data-i18n="blog.about_post">{t('blog.about_post', locale)}</p>
      <h2 class="post-title"><span data-i18n="blog.written_by">{t('blog.written_by', locale)}</span> <span data-author-name>{siteText.authorName}</span></h2>
      <p class="post-summary" data-author-bio>{siteText.authorBio}</p>
    </aside>
  </article>
</BaseLayout>
