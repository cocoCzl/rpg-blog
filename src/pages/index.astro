---
import { getCollection } from 'astro:content'
import GuildPixelIcon from '../components/GuildPixelIcon'
import BaseLayout from '../layouts/BaseLayout.astro'
import config from '../../site.config'
import { t } from '../lib/i18n'
import { formatDate, localized } from '../lib/locale'
import { getAllCategories, getAllTags, getPostSlug, getPublishedPosts } from '../lib/posts'
import { getSiteText } from '../lib/site-text'

const locale = config.locale
const siteText = getSiteText(config, locale)
const posts = getPublishedPosts(await getCollection('posts'))
const pinned = posts.find((post) => post.data.featured) || posts[0]
const saves = posts.filter((post) => post.id !== pinned?.id).slice(0, 4)
const chapters = getAllCategories(posts).slice(0, 5)
const clues = getAllTags(posts).slice(0, 8)
const socialLinks = Object.entries(config.social).filter(([, href]) => href)
const commandItems = [
  { href: '/archive', label: t('nav.posts', locale), icon: 'journal' as const },
  { href: '/chapters', label: t('home.regions', locale), icon: 'chapter' as const },
  { href: '/tags', label: t('home.clues', locale), icon: 'clue' as const },
  { href: '/about', label: t('home.profile', locale), icon: 'profile' as const },
]
---

<BaseLayout>
  <section class="retro-hero" aria-labelledby="guild-title">
    <div class="retro-spark spark-a" aria-hidden="true">✦</div>
    <div class="retro-spark spark-b" aria-hidden="true">✦</div>

    <aside class="floating-card floating-command tilt-left" aria-labelledby="command-menu-title">
      <p class="eyebrow" id="command-menu-title" data-i18n="home.command_menu">{t('home.command_menu', locale)}</p>
      <div class="command-list">
        {commandItems.map((item) => (
          <a class="command-item" href={item.href}>
            <span>
              <GuildPixelIcon name={item.icon} label="" size={20} />
              {item.label}
            </span>
          </a>
        ))}
      </div>
    </aside>

    <aside class="floating-card floating-profile tilt-right" aria-labelledby="character-slot-title">
      <p class="eyebrow" id="character-slot-title" data-i18n="home.about">{t('home.about', locale)}</p>
      <div class="profile-mini">
        <div class="profile-avatar" aria-hidden="true">
          {config.author.avatar ? <img src={config.author.avatar} alt="" /> : <span class="avatar-sprite"></span>}
        </div>
        <div>
          <strong data-author-name>{siteText.authorName}</strong>
          <p class="post-summary" data-author-bio>{siteText.authorBio}</p>
        </div>
      </div>
    </aside>

    <div class="container retro-hero-center">
      <span class="retro-label" data-i18n="home.guild_interface">{t('home.guild_interface', locale)}</span>
      <h1 id="guild-title" class="retro-title" data-site-title>{siteText.title}</h1>
      <p class="retro-subtitle" data-site-description>{siteText.description}</p>
      <div class="hero-actions">
        <a class="pixel-button primary" href={pinned ? `/posts/${getPostSlug(pinned)}` : '/archive'} data-i18n="home.read_more">{t('home.read_more', locale)}</a>
        <a class="pixel-button" href="/about" data-i18n="home.profile">{t('home.profile', locale)}</a>
      </div>
    </div>

    {pinned && (
      <a class="floating-card floating-quest tilt-left-soft" href={`/posts/${getPostSlug(pinned)}`}>
        <span class="eyebrow" data-i18n="home.featured">{t('home.featured', locale)}</span>
        <strong>{pinned.data.title}</strong>
        <span class="post-summary">{pinned.data.summary}</span>
      </a>
    )}

    <aside class="floating-card floating-clues tilt-right-soft">
      <p class="eyebrow" data-i18n="home.clues">{t('home.clues', locale)}</p>
      <div class="tag-list">
        {clues.slice(0, 5).map(({ tag }) => <a class="badge" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}
      </div>
    </aside>
  </section>

  <section class="container retro-section" aria-labelledby="save-slots-title">
    <div class="section-toolbar">
      <h2 class="section-title" data-i18n="home.latest">{t('home.latest', locale)}</h2>
      <div class="section-actions" aria-label="Guild journal shortcuts">
        <a class="toolbar-link" href="/chapters" data-i18n="home.regions">{t('home.regions', locale)}</a>
        {socialLinks.length > 0 && <a class="toolbar-link" href="#public-links" data-i18n="home.mailbox">{t('home.mailbox', locale)}</a>}
        <a class="toolbar-link" href="/feed.xml" data-i18n="home.rss_feed">{t('home.rss_feed', locale)}</a>
      </div>
    </div>
    <div class="save-list retro-save-grid">
      {saves.length > 0 ? saves.map((post, index) => (
        <a class="save-slot" href={`/posts/${getPostSlug(post)}`}>
          <span class="save-index">{String(index + 1).padStart(2, '0')}</span>
          <span class="stack">
            <span class="post-meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
              {post.data.category && <span>{post.data.category}</span>}
              {post.data.tags.slice(0, 2).map((tag) => <span>#{tag}</span>)}
            </span>
            <strong class="post-title">{post.data.title}</strong>
            <span class="post-summary">{post.data.summary}</span>
          </span>
        </a>
      )) : (
        <p class="post-summary" data-i18n="home.slot_empty">{t('home.slot_empty', locale)}</p>
      )}
    </div>
  </section>

  {(config.display.showToolbox || socialLinks.length > 0) && (
    <section class="container home-support-strip" aria-label="Guild journal support links">
      {config.display.showToolbox ? (
        <article id="inventory-toolkit" class="support-panel toolbox-panel">
          <div class="support-panel-header">
            <p class="eyebrow" data-i18n="home.toolbox">{t('home.toolbox', locale)}</p>
            {socialLinks.length > 0 && (
              <div id="public-links" class="tag-list compact-links" aria-label={t('home.mailbox', locale)}>
                <span class="compact-links-label" data-i18n="home.mailbox">{t('home.mailbox', locale)}</span>
                {socialLinks.map(([label, href]) => <a class="badge" href={href as string}>{label}</a>)}
              </div>
            )}
          </div>
          <div class="toolbox-strip">
            {config.home.toolbox.map((item) => {
              const Tag = item.href ? 'a' : 'div'
              return (
                <Tag class="toolkit-item compact" href={item.href}>
                  <strong>{localized(item.title, locale)}</strong>
                  <span class="post-summary">{localized(item.detail, locale)}</span>
                </Tag>
              )
            })}
          </div>
        </article>
      ) : (
        <article id="public-links" class="support-panel links-card">
          <p class="eyebrow" data-i18n="home.mailbox">{t('home.mailbox', locale)}</p>
          <div class="tag-list compact-links">
            {socialLinks.map(([label, href]) => <a class="badge" href={href as string}>{label}</a>)}
          </div>
        </article>
      )}
    </section>
  )}
</BaseLayout>
