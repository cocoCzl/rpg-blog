---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import config from '../../../site.config'
import { t } from '../../lib/i18n'
import { formatDate } from '../../lib/locale'
import { getAllCategories, getPostSlug, getPostsByCategory } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return getAllCategories(posts).map(({ category }) => ({
    params: { chapter: category },
    props: { chapter: category },
  }))
}

const locale = config.locale
const { chapter } = Astro.props
const posts = getPostsByCategory(await getCollection('posts'), chapter)
---

<BaseLayout title={chapter} description={t('archive.description', locale)}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow" data-i18n="home.regions">{t('home.regions', locale)}</p>
      <h1 class="hero-title">{chapter}</h1>
      <p class="hero-copy" data-i18n="archive.description">{t('archive.description', locale)}</p>
    </div>
  </section>

  <section class="container stack">
    {posts.map((post) => (
      <article class="journal-card panel-pad">
        <a href={`/posts/${getPostSlug(post)}`} style="text-decoration: none;">
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
            {post.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
          </div>
          <h2 class="post-title">{post.data.title}</h2>
          <p class="post-summary">{post.data.summary}</p>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>

