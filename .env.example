# Admin credentials (change these immediately!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_immediately

# GitHub OAuth App credentials
# Create an OAuth App at: https://github.com/settings/developers
# Homepage URL: your blog URL
# Callback URL: your blog URL + /api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session encryption secret (generate a random string)
SESSION_SECRET=change_me_to_random_string
