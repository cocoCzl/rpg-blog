# Public site URL used for canonical URLs, sitemap, RSS and OAuth callback generation.
SITE_URL=http://localhost:4321

# Admin credentials. Production startup fails if these are missing or left at unsafe defaults.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=replace_with_a_long_random_password

# GitHub OAuth App credentials
# Create an OAuth App at: https://github.com/settings/developers
# Homepage URL: your blog URL
# Callback URL: your blog URL + /api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session signing secret (generate a long random string, 32+ chars recommended)
SESSION_SECRET=replace_with_a_long_random_session_secret

# Optional. Defaults shown below are suitable for local development.
SQLITE_PATH=./data/rpg-blog.db
UPLOAD_PATH=./data/uploads
UPLOAD_URL_BASE=/uploads
