# Production URL used for canonical URLs, sitemap, RSS and OAuth callback generation.
SITE_URL=https://your-domain.com

# Required admin credentials.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=replace_with_a_long_random_password

# Required session signing secret.
SESSION_SECRET=replace_with_a_long_random_session_secret

# Optional GitHub OAuth credentials for reader comments.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Persistent storage paths for server deployments.
SQLITE_PATH=/app/storage/rpg-blog.db
UPLOAD_PATH=/app/storage/uploads
UPLOAD_URL_BASE=/uploads
